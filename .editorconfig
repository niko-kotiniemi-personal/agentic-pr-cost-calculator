# Keeps every editor writing files the way the checks expect.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[vendor/**]
# Vendored files are upstream's and are never edited here.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
